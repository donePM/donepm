{
  "name": "@donepm/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": {
      "types": "./dist/config/config.d.ts",
      "default": "./dist/config/config.js"
    },
    "./paths": {
      "types": "./dist/config/paths.d.ts",
      "default": "./dist/config/paths.js"
    },
    "./exec": {
      "types": "./dist/process/exec.d.ts",
      "default": "./dist/process/exec.js"
    },
    "./status": {
      "types": "./dist/status/status.d.ts",
      "default": "./dist/status/status.js"
    }
  },
  "bin": {
    "donepm-bridge": "dist/bridge/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & DONEPM_DEV_ORIGIN=http://localhost:5173 node --watch dist/index.js)"
  },
  "dependencies": {
    "@donepm/core": "workspace:*",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "jira2md": "^3.0.1",
    "marklassian": "^1.2.1",
    "turndown": "^7.2.4",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2"
  },
  "files": [
    "dist",
    "public",
    "playbooks"
  ]
}
